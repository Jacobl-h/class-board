    "partyserver": "0.5.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.3",
    "@cloudflare/workers-types": "5.20260929.1",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
